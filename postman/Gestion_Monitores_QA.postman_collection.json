{
  "info": {
    "name": "Gestión de monitores - Pruebas QA",
    "description": "Colección para probar los endpoints a través de PHP (8000), Python (5000) o Java (8080). Ejecutar las carpetas 01, 02 y 03 en ese orden. La carpeta 03 crea, actualiza y elimina un monitor temporal. Si el código temporal ya existe, cambiar codigo_prueba antes de ejecutar. Los casos con código 202601 presuponen que el dato semilla está presente en SQLite. Java valida campos y correo; algunos mensajes pueden variar sin cambiar el código HTTP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "codigo_prueba",
      "value": "202699",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Consultas sin modificar datos",
      "item": [
        {
          "name": "Consultar materias",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/materias",
            "description": "GET /api/materias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Materias como lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar monitores",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/monitores",
            "description": "GET /api/monitores"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Monitores como lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar monitor existente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/monitores/202601",
            "description": "GET /api/monitores/202601"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Código correcto\", () => pm.expect(pm.response.json().codigo).to.eql(\"202601\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Monitor inexistente - 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/monitores/999999",
            "description": "GET /api/monitores/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Error explicado\", () => pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Método no permitido - 405",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/materias",
            "description": "DELETE /api/materias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 405\", function () { pm.response.to.have.status(405); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Permite únicamente GET\", () => pm.expect(pm.response.headers.get(\"Allow\")).to.include(\"GET\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Validaciones de errores",
      "item": [
        {
          "name": "Campos vacíos - 400",
