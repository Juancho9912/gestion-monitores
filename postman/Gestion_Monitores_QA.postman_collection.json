                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/monitores",
            "description": "POST /api/monitores",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigo_prueba}}\",\n  \"nombre_completo\": \"\",\n  \"correo\": \"\",\n  \"materia_id\": 1\n}",
