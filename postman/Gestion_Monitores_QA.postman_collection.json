                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Error explicado\", () => pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - CRUD secuencial (ejecutar en orden)",
      "item": [
        {
          "name": "1. Crear monitor temporal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/monitores",
            "description": "POST /api/monitores",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigo_prueba}}\",\n  \"nombre_completo\": \"Monitor QA Prueba\",\n  \"correo\": \"monitor.qa@ejemplo.edu.co\",\n  \"materia_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Registro exitoso (200 o 201)\", () => pm.expect([200,201]).to.include(pm.response.code));",
                  "pm.test(\"Código creado\", () => pm.expect(pm.response.json().codigo).to.eql(pm.collectionVariables.get(\"codigo_prueba\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Consultar monitor temporal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
