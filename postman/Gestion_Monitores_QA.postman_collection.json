              "raw": "{\n  \"codigo\": \"202601\",\n  \"nombre_completo\": \"Monitor Duplicado QA\",\n  \"correo\": \"monitor.duplicado@ejemplo.edu.co\",\n  \"materia_id\": 1\n}",
