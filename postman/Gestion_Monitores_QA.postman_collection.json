              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Respuesta JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Código coincide\", () => pm.expect(pm.response.json().codigo).to.eql(pm.collectionVariables.get(\"codigo_prueba\")));"
                ]
              }
            }
          ]
        },
